+    queryArgs.paramsSize = sizeof(pContext->channels);
+    if (ioctl(fd, OP_QUERY, &queryArgs) < 0) {
+        fprintf(stderr, "NvRmQuery ioctl failed: errno=%d\n", errno);
+        return NV_ERR_GENERIC;
+    }
+    if (queryArgs.status != NV_OK)
+        return queryArgs.status;
+    if (queryArgs.hClient == 0 || queryArgs.hObject == 0 ||
+        pContext->channels.numChannels == 0 ||
+        pContext->channels.numChannels > NV2080_CTRL_FIFO_DISABLE_CHANNELS_MAX_ENTRIES)
+        return NV_ERR_GENERIC;
     pContext->hClient = queryArgs.hClient;
     pContext->hObject = queryArgs.hObject;
     return queryArgs.status;
 }
@@ -56,6 +80,20 @@
-    NVA06C_CTRL_TIMESLICE_PARAMS timesliceParams0;
+    if (!ctx.hClient || !ctx.hObject || !timesliceUs || fd < 0)
