+std::vector<double>
+ExpertDispatcher::NumericalDeterministicAccumulationCheck(
+    int64_t rows, double rtol, double atol) {
+  TORCH_CHECK(rows == 353, "deterministic accumulation test requires 353 rows");
+  constexpr int64_t hdim = 64;
+  constexpr int64_t experts = 4;
+  auto options = torch::TensorOptions()
+                     .dtype(torch::kFloat32)
+                     .device(CUDA_DEVICE(at::cuda::current_device()));
+  auto base = torch::arange(rows * hdim, options).reshape({rows, hdim});
+  auto mask = torch::ones({rows}, options.dtype(torch::kBool));
+  auto router_weight = torch::empty({rows, experts}, options);
+  std::vector<torch::Tensor> outputs;
+  for (int64_t expert = 0; expert < experts; ++expert) {
+    router_weight.index_put_({torch::indexing::Slice(), expert},
+                             0.1 * static_cast<double>(expert + 1));
+    outputs.push_back(
+        torch::sin(base * (0.003 * static_cast<double>(expert + 1))));
+  }
+
+  auto reference = torch::zeros({rows, hdim}, options);
+  for (int64_t expert = 0; expert < experts; ++expert) {
+    reference.add_(outputs[expert] *
+                   router_weight.index(
+                       {torch::indexing::Slice(), expert}).unsqueeze(1));
+  }
+  CUDA_CHECK(cudaStreamSynchronize(
+      at::cuda::getCurrentCUDAStream().stream()));
+
+  std::vector<int64_t> order = {3, 1, 0, 2};
+  double max_abs = 0.0;
+  double max_rel = 0.0;
+  bool exact = true;
+  for (int repetition = 0; repetition < 4; ++repetition) {
+    std::vector<PendingAccumulation> pending;
+    for (int64_t expert : order) {
+      pending.emplace_back(expert, outputs[expert], mask);
+    }
+    auto actual = torch::zeros({rows, hdim}, options);
+    AccumulateInExpertOrder(actual, router_weight, rows, std::move(pending));
+    CUDA_CHECK(cudaStreamSynchronize(
+        at::cuda::getCurrentCUDAStream().stream()));
+    auto absolute = (actual - reference).abs();
+    max_abs = std::max(max_abs, absolute.max().item<double>());
+    auto denominator = reference.abs().clamp_min(1.0e-6);
+    max_rel = std::max(
+        max_rel, (absolute / denominator).max().item<double>());
+    exact = exact && torch::equal(actual, reference) &&
+            torch::allclose(actual, reference, rtol, atol);
+    std::rotate(order.begin(), order.begin() + 1, order.end());
+  }
+  return {max_abs, max_rel, exact ? 1.0 : 0.0};
+}
