+          {"prefetch_wasted", activation_wasted_.load()},
+          {"prefetch_bytes", activation_bytes_.load()},
+          {"prefetch_wasted_bytes", activation_wasted_bytes_.load()},
+          {"prefetch_unused_resident", unused_activation_prefetch_.size()},
+          {"prefetch_unused_resident_bytes", unused_resident_bytes},
+          {"prefetch_prediction_epoch", activation_prediction_.Epoch()},
+          {"prefetch_protected_candidates", activation_prediction_.Size()},
+          {"prefetch_protected_resident_skips", activation_protected_skips_.load()},
+          {"prefetch_stale_discarded", activation_stale_.load()},
+          {"prefetch_no_victim", activation_no_victim_.load()},
+          {"prefetch_copy_started", activation_copy_started_.load()},
+          {"prefetch_victim_recheck_rejected", activation_victim_recheck_rejected_.load()},
+          {"prefetch_copy_waits", prefetch_copy_waits_.load()},
