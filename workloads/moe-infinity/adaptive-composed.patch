+          {"demand_prefetch_wait_ns", demand_prefetch_wait_ns_.load()},
+          {"demand_cache_waits", demand_cache_waits_.load()},
+          {"demand_cache_wait_ns", demand_cache_wait_ns_.load()},
+          {"temporary_slot_uses", temporary_slot_uses_.load()},
