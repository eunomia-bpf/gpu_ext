     return controlArgs.status;
 }
@@ -33,19 +40,34 @@
 NV_STATUS NvRmQuery(
     NvContext *pContext
 ) {
+    if (pContext == nullptr || pContext->hClient == 0)
+        return NV_ERR_GENERIC;
+    const NvHandle creatorTid = pContext->hClient;
+    *pContext = NvContext{};
     if (fd < 0) {
-        fd = open("/dev/nvidiactl", O_RDWR);
+        fd = open("/dev/nvidiactl", O_RDWR | O_CLOEXEC);
