+  auto resize_buffers = [&](int64_t rows) {
+    for (auto& buffer : buffer_) {
+      auto shape_vec = buffer.sizes().vec();
+      if (shape_vec.size() != 2) continue;
+      int64_t col = buffer.size(1);
+      auto dtype = buffer.dtype();
+      if (buffer.size(0) != rows) {
+        // Every buffer owns storage for kMaxTokens rows. Only its logical view
+        // changes between chunks; no allocation or data movement occurs here.
+        TORCH_CHECK(rows <= kMaxTokens,
+                    "expert buffer view exceeds allocated row capacity");
+        buffer.set_data(torch::from_blob(
+            buffer.data_ptr(), {rows, col}, DoNothingDeleter<void>{},
+            torch::TensorOptions().dtype(dtype).device(
+                CUDA_DEVICE(at::cuda::current_device()))));
+      }
     }
+  };
+
+  // Preserve the original single-workspace path for every previously
+  // supported invocation. This keeps decode and ordinary prefill calls on the
+  // same copy, compute, synchronize, and clone sequence as upstream.
+  if (batch_size <= kMaxTokens) {
+    cudaMemcpyAsync(input_.data_ptr(), hidden_states.data_ptr(),
+                    hidden_states.numel() * hidden_states.element_size(),
+                    cudaMemcpyDeviceToDevice, stream);
+    resize_buffers(batch_size);
+    cudaStreamSynchronize(stream);
+
+    ForwardHelper(stream);
+    param_set_ = false;
+    cudaStreamSynchronize(stream);
+
+    auto output = output_.clone();
+    resize_buffers(kMaxTokens);
