+// Opaque token saved by AdoptWindowRelayExtra(): the launch configuration
+// (extra_/params_) in effect before the relay was adopted. A no-op token is
+// produced when the relay cannot be adopted or is already active.
+struct WindowRelayToken
+{
+    void **extra;
+    void **params;
+    bool noop;
+};
+
+void *CudaKernelCommand::AdoptWindowRelayExtra(const void *window_args)
+{
+    WindowRelayToken *token = new WindowRelayToken{extra_, params_, false};
+    // single active relay per command (adoption runs under the launch mutex);
+    // a second adoption restores as a no-op
+    if (relay_extra_ != nullptr) {
+        token->noop = true;
+        return token;
+    }
+
+    // sm_120 window-args relay: the guardian/resume prefix consumes the
+    // 28-byte argument block at the absolute debugger window base
+    // XG_DEBUGGER_BASE (0x1880, xsched_guardian_abi.h), which lies outside
+    // the workload kernel's declared constant-bank extent and is therefore
+    // not covered by the kernel params. CU_LAUNCH_PARAM_BUFFER bytes are
+    // argument-buffer-relative (same coordinate system the ctor uses with
+    // cuXtraGetParamInfo offsets for extra_data_), so the window is placed
+    // at (absolute window base - sm_120 parameter base) inside the blob and
+    // both the real kernel params and the window args ride one blob through
+    // the normal launch-parameter upload.
+    const size_t kWindowBaseAbs = 0x1880; // XG_DEBUGGER_BASE
+    const size_t kWindowBytes = 28;       // XG_ARGS_BYTES
+    // constant-bank parameter base established for this explicitly
+    // sm_120-scoped adapter from the dagger workload cubins; not derived
+    // from cuXtraGetParamInfo
+    const size_t kParamBaseAbs = 0x380;
+    if (param_cnt_ == 0 || params_ == nullptr) {
+        XERRO_NOEXIT("window relay unsupported: kernel %p has param_cnt=%zu params_=%p",
+              (void *)kFunc, param_cnt_, (void *)params_);
+        token->noop = true;
+        return token; // launch as before (window stays undelivered)
+    }
+    size_t last_offset = 0, last_size = 0;
+    cuXtraGetParamInfo(kFuncHandle, param_cnt_ - 1, &last_offset, &last_size,
+                       nullptr);
+    size_t rel_param_end = last_offset + last_size;
+    size_t rel_window_base = kWindowBaseAbs - kParamBaseAbs; // 0x1500
+    if (rel_param_end > rel_window_base) {
+        XERRO_NOEXIT("window relay unsupported: kernel %p params end at 0x%zx, "
+                     "past blob-relative window base 0x%zx",
+                     (void *)kFunc, rel_param_end, rel_window_base);
+        token->noop = true;
+        return token; // launch as before (window stays undelivered)
+    }
+    size_t blob_size = rel_param_end > rel_window_base + kWindowBytes
+                     ? rel_param_end : rel_window_base + kWindowBytes;
+    blob_size = (blob_size + 0xf) & ~(size_t)0xf;
+    char *blob = (char *)malloc(blob_size);
+    XASSERT(blob != nullptr, "window relay blob malloc failed (%zu B)", blob_size);
+    memset(blob, 0, blob_size);
+    for (size_t i = 0; i != param_cnt_; ++i) {
+        size_t offset, size;
+        cuXtraGetParamInfo(kFuncHandle, i, &offset, &size, nullptr);
+        XASSERT(offset + size <= blob_size,
+                "window relay param %zu out of blob range: %zu + %zu > %zu",
+                i, offset, size, blob_size);
+        memcpy(blob + offset, params_[i], size);
+    }
+    memcpy(blob + rel_window_base, window_args, kWindowBytes);
+
+    // relay_blob_size_ must outlive the launch (extra_[3] points to it)
+    relay_blob_ = blob;
+    relay_blob_size_ = blob_size;
+    relay_extra_ = new void *[5];
+    relay_extra_[0] = CU_LAUNCH_PARAM_BUFFER_POINTER;
+    relay_extra_[1] = relay_blob_;
+    relay_extra_[2] = CU_LAUNCH_PARAM_BUFFER_SIZE;
+    relay_extra_[3] = (void *)&relay_blob_size_;
+    relay_extra_[4] = CU_LAUNCH_PARAM_END;
+    // launch with the blob only, regardless of the command's original form;
+    // the saved token restores both members after the launch. Original
+    // extra-buffer commands still marshal correctly: their params_[i] point
+    // into extra_data_, which this loop reads.
+    extra_ = relay_extra_;
+    params_ = nullptr;
+    return token;
+}
+
+void CudaKernelCommand::RestoreWindowRelayExtra(void *token_v)
+{
+    WindowRelayToken *token = (WindowRelayToken *)token_v;
+    if (token == nullptr) return;
+    bool noop = token->noop;
+    if (!noop) {
+        extra_ = token->extra;
+        params_ = token->params;
+    }
+    delete token;
+    if (noop) return;
+    if (relay_extra_ != nullptr) {
+        delete[] relay_extra_;
+        relay_extra_ = nullptr;
+    }
+    if (relay_blob_ != nullptr) {
+        free(relay_blob_);
+        relay_blob_ = nullptr;
+    }
+    relay_blob_size_ = 0;
+}
