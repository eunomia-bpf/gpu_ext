+    // 575 compatibility transport: driver revalidates ownership and permits
+    // only SET_TIMESLICE; general RM_CONTROL security checks remain intact.
+    NVOS54_PARAMETERS control{};
+    control.hClient = ctx.hClient;
+    control.hObject = ctx.hObject;
+    control.cmd = NVA06C_CTRL_CMD_SET_TIMESLICE;
+    control.flags = 0x00010001; // Version 1, operation 1.
+    control.params = &timesliceParams0;
+    control.paramsSize = sizeof(timesliceParams0);
+    if (ioctl(fd, OP_QUERY, &control) < 0) {
+        fprintf(stderr, "NvRmModifyTS scoped ioctl failed: errno=%d\n", errno);
+        return NV_ERR_GENERIC;
+    }
+    return control.status;
 }
