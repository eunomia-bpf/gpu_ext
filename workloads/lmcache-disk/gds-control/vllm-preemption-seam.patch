+    def _select_preempt_victim(self, default_victim: Request) -> Request:
+        """Return the running request to preempt for the current step.
+
+        Returns the stock victim choice (`default_victim`) unless
+        `self.preempt_victim_callback` is set. When set, the callback is
+        called as `callback(self.running, default_victim)` and may return
+        a different existing member of `self.running` to preempt instead,
+        or None to keep `default_victim`. A return value that is not a
+        current member of `self.running` (checked by identity) is ignored
+        and `default_victim` is used. Under the PRIORITY policy, an
+        override must also share `default_victim`'s priority value, i.e.
+        stay in the stock worst-priority class (the arrival-time
+        tie-break may differ); otherwise `default_victim` is used. This
+        method only performs victim selection; the caller removes the
+        returned request from
+        `self.running`, adjusts `req_index` when a callback-selected victim
+        sat before the scheduling cursor, and rolls back any same-step
+        schedule state.
+        """
+        if self.preempt_victim_callback is None:
+            return default_victim
+        victim = self.preempt_victim_callback(self.running, default_victim)
+        if victim is None or victim is default_victim:
+            return default_victim
+        in_running = False
+        for running_req in self.running:
+            if running_req is victim:
+                in_running = True
+                break
+        if not in_running:
+            logger.warning(
+                "preempt_victim_callback returned a request that is not in "
+                "the running list; falling back to the stock victim choice.",
+            )
+            return default_victim
+        if (
+            self.policy == SchedulingPolicy.PRIORITY
+            and victim.priority != default_victim.priority
+        ):
+            # Under the PRIORITY policy, preemption stays within the stock
+            # worst-priority class; only the arrival-time tie-break may
+            # change.
+            logger.warning(
+                "preempt_victim_callback returned a request with priority "
+                "%s, outside the stock victim's priority class %s; falling "
+                "back to the stock victim choice.",
+                victim.priority,
+                default_victim.priority,
+            )
+            return default_victim
+        return victim
+
