+bool ExpertDispatcher::EvictActivationVictim(const ExpertNodePtr& victim, int gpu_id,
+                                             uint64_t prediction_epoch) {
+  if (!victim || !victim->node) return false;
+  std::lock_guard<std::mutex> lock(activation_mutex_);
+  uint64_t key = (uint64_t(victim->layer_idx) << 32) | victim->expert_idx;
+  if (prediction_epoch && !activation_prediction_.MayEvict(prediction_epoch, key)) {
+    activation_victim_recheck_rejected_.fetch_add(1, std::memory_order_relaxed);
+    return false;  // prediction/protection may have changed since selection
+  }
+  auto node = victim->node;
+  if (!node->device.is_cuda() || node->pending_dispatches.load() != 0) return false;
+  auto expected = NodeExecState::IDLE;
+  if (!node->exec_state.compare_exchange_strong(expected, NodeExecState::FETCHING))
+    return false;  // demand may have claimed it after the selection snapshot
+  // Enqueue takes the same mutex: it cannot observe or execute freed storage.
+  node->SetDevice(node->default_host);
+  cache_sizes_[gpu_id] += node->byte_size;
+  cached_experts_[gpu_id].erase(key);
+  if (unused_activation_prefetch_.erase(key)) {
+    activation_wasted_.fetch_add(1);
+    activation_wasted_bytes_.fetch_add(node->byte_size);
+  }
+  activation_evictions_.fetch_add(1);
+  if (prediction_epoch)
+    activation_prefetch_evictions_.fetch_add(1, std::memory_order_relaxed);
+  else
+    activation_demand_evictions_.fetch_add(1, std::memory_order_relaxed);
+  node->exec_state.store(NodeExecState::IDLE, std::memory_order_release);
+  cache_cv_[gpu_id].notify_all();
+  return true;
+}
+
+void ExpertDispatcher::FetchActivationPrefetch(const CallArgs& args, int gpu_id) {
+  auto expert = experts_[args.expert_idx][args.layer_idx];
+  auto node = expert->node;
+  if (!node) return;
+  {
+    std::lock_guard<std::mutex> lock(activation_mutex_);
+    if (!activation_prediction_.Current(args.prediction_epoch)) {
+      activation_stale_.fetch_add(1, std::memory_order_relaxed);
+      return;
+    }
+    if (node->device.is_cuda() || node->pending_dispatches.load() != 0 ||
+        node->exec_state.load() != NodeExecState::IDLE) return;
+    node->is_prefetching.store(true, std::memory_order_release);
+    auto expected = NodeExecState::IDLE;
+    if (!node->exec_state.compare_exchange_strong(expected, NodeExecState::FETCHING)) {
+      node->is_prefetching.store(false, std::memory_order_release);
+      return;
+    }
+  }
+  auto release = [&]() {
+    std::lock_guard<std::mutex> lock(activation_mutex_);
+    node->is_prefetching.store(false, std::memory_order_release);
+    node->exec_state.store(NodeExecState::IDLE, std::memory_order_release);
+    cache_cv_[gpu_id].notify_all();
+  };
+  while (cache_sizes_[gpu_id] < node->byte_size) {
+    auto victim = FindExpertEvict(gpu_id, args.prediction_epoch);
+    if (!EvictActivationVictim(victim, gpu_id, args.prediction_epoch)) {
+      {
+        std::lock_guard<std::mutex> lock(activation_mutex_);
+        if (!activation_prediction_.Current(args.prediction_epoch))
+          activation_stale_.fetch_add(1, std::memory_order_relaxed);
+        else
+          activation_no_victim_.fetch_add(1, std::memory_order_relaxed);
+      }
+      release(); return;  // never stall demand for speculation
+    }
+  }
+  cudaEvent_t done = nullptr;
+  {
+    std::unique_lock<std::mutex> lock(activation_mutex_);
+    if (!activation_prediction_.Current(args.prediction_epoch)) {
+      activation_stale_.fetch_add(1, std::memory_order_relaxed);
+      lock.unlock();
+      release(); return;
+    }
+    // Last stale check and physical issue share the publisher's mutex. A new
+    // prediction cannot slip between them. Do not hold this mutex through the
+    // event wait: an already-issued transfer may complete under a newer epoch.
+    node->SetDevice(CUDA_DEVICE(gpu_id), true, fetch_streams_[gpu_id], &done);
+    activation_copy_started_.fetch_add(1, std::memory_order_relaxed);
+  }
+  if (done) {
+    // Whole-entry copy is physically in flight between issue and completion;
+    // the queue ledger already carries the popped entry bytes as inflight,
+    // so no extra bookkeeping is needed here. Wait for the copy, then the
+    // worker's CompleteBackground() releases the bytes from the snapshot.
+    auto wait_started = std::chrono::steady_clock::now();
+    CUDA_CHECK(cudaEventSynchronize(done));
+    auto wait_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now() - wait_started).count();
+    prefetch_copy_waits_.fetch_add(1, std::memory_order_relaxed);
+    prefetch_copy_wait_ns_.fetch_add(wait_ns, std::memory_order_relaxed);
+    kCudaEventPool->Release(done);
+  }
+  uint64_t key = (uint64_t(args.layer_idx) << 32) | args.expert_idx;
+  cache_sizes_[gpu_id] -= node->byte_size;
+  cached_experts_[gpu_id].insert(key);
+  {
+    std::lock_guard<std::mutex> lock(activation_mutex_);
+    unused_activation_prefetch_.insert(key);
+  }
+  activation_completed_.fetch_add(1);
+  activation_bytes_.fetch_add(node->byte_size);
+  release();
+}
