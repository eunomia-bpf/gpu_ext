+static uint64_t requested_ring_entries(void)
+{
+	const char *value = getenv("BPFTIME_KERNELRETSNOOP_RING_ENTRIES");
+	if (!value || !*value)
+		return 0;
+	errno = 0;
+	char *end = NULL;
+	const unsigned long long parsed = strtoull(value, &end, 10);
+	if (errno || end == value || *end != '\0' || *value == '-' ||
+	    parsed > UINT_MAX)
+		return 0;
+	return parsed;
+}
