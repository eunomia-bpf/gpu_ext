diff --git a/moe_infinity/entrypoints/openai/revision_server.py b/moe_infinity/entrypoints/openai/revision_server.py
new file mode 100644
--- /dev/null
+++ b/moe_infinity/entrypoints/openai/revision_server.py
@@ -0,0 +1,140 @@
+"""Measurement-only entrypoint for the approved RTX 5090 revision run."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import os
+from typing import Any
+
+import torch
+from fastapi.responses import JSONResponse
+
+from moe_infinity.entrypoints.openai import api_server_v2 as server
+
+
+torch.set_num_threads(8)
+
+
+async def lossless_completion_events(*, request_id, created, model_name, stream, raw_request):
+    """Do not cancel a token-consuming worker when merely polling disconnects."""
+    runtime, manager = server._ensure_runtime_ready()
+    state = manager._require_stream(request_id)
+    pending = None
+    finished = False
+    try:
+        while True:
+            if await raw_request.is_disconnected():
+                return
+            if pending is None:
+                pending = asyncio.create_task(asyncio.to_thread(server._next_stream_event, stream))
+            try:
+                event = await asyncio.wait_for(asyncio.shield(pending), timeout=0.1)
+            except asyncio.TimeoutError:
+                continue
+            pending = None
+            if event is None:
+                finished = True
+                return
+            if event == "data: [DONE]\n\n":
+                finished = True
+                yield event
+                return
+            if not event.startswith("data: "):
+                continue
+            payload = json.loads(event[len("data: "):])
+            choices = payload.get("choices", [])
+            choice = choices[0] if choices else {}
+            delta = choice.get("delta", {})
+            yield server._make_completion_stream_chunk(
+                request_id=request_id, created=created, model_name=model_name,
+                token_text=delta.get("content", "") if isinstance(delta, dict) else "",
+                finish_reason=choice.get("finish_reason"),
+            )
+    finally:
+        if not finished:
+            runtime.abort_request(request_id)
+        # abort_request alone does not wake StreamManager's condition waiter.
+        with state.condition:
+            state.finished = True
+            state.condition.notify_all()
+        if pending is not None:
+            await asyncio.shield(pending)
+        stream.close()
+
+
+server._completion_event_generator = lossless_completion_events
+
+
+def _unavailable(message: str) -> JSONResponse:
+    return JSONResponse(
+        status_code=503,
+        content={"error": {"message": message, "type": "server_error"}},
+    )
+
+
+@server.app.get("/revision/stats")
+async def revision_stats() -> JSONResponse:
+    runtime = server.engine
+    if runtime is None:
+        return _unavailable("Service is starting. Please retry shortly.")
+
+    offload_engine: Any = getattr(runtime, "engine", None)
+    dispatcher: Any = getattr(offload_engine, "expert_dispatcher", None)
+    get_cache_counts = getattr(dispatcher, "get_cache_counts", None)
+    if not callable(get_cache_counts):
+        return _unavailable("Side-effect-free expert cache counters unavailable.")
+
+    accesses_raw, hits_raw = get_cache_counts()
+    accesses = int(accesses_raw)
+    hits = int(hits_raw)
+    if accesses < 0 or hits < 0 or hits > accesses:
+        return _unavailable("Expert cache counters are inconsistent.")
+
+    get_exposed = getattr(offload_engine, "get_exposed_fetch_seconds", None)
+    exposed_seconds = float(get_exposed()) if callable(get_exposed) else 0.0
+    stats = runtime.get_stats()
+
+    return JSONResponse(
+        content={
+            "engine_generated_tokens": int(
+                stats.get("total_generated_tokens", 0)
+            ),
+            "engine_steps": int(stats.get("num_steps", 0)),
+            "expert_cache_accesses": accesses,
+            "expert_cache_hits": hits,
+            "expert_cache_misses": accesses - hits,
+            "exposed_fetch_seconds_total": exposed_seconds,
+            "kv_cache_num_blocks": int(stats.get("kv_cache_num_blocks", 0)),
+        }
+    )
+
+
+def main() -> None:
+    """Run the official server with its original initialization sequence."""
+
+    args = server.parse_args()
+    server._max_waiting_requests = max(0, int(args.max_waiting_requests))
+    server._max_n = max(1, int(args.max_n))
+    server._configure_auth(
+        args.api_key or os.environ.get("MOE_API_KEYS"), args.rate_limit
+    )
+    with server._contextpilot_state_lock:
+        server._contextpilot_enabled = server._resolve_contextpilot_enabled(
+            args.enable_contextpilot
+        )
+        server._contextpilot_debug = bool(args.contextpilot_debug)
+        server._contextpilot_fault = "none"
+    server._startup_args = args
+
+    server.uvicorn.run(
+        server.app,
+        host=args.host,
+        port=args.port,
+        log_level="info",
+        timeout_keep_alive=server.TIMEOUT_KEEP_ALIVE,
+    )
+
+
+if __name__ == "__main__":
+    main()
