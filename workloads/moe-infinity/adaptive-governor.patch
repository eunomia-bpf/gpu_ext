+// ---- Adaptive speculative-admission governor (experiment-local) ----
+// Modes: 1 unbounded (rule bypassed; publish the full rank), 2 fixed budget,
+// 3 adaptive (same live headroom rule; budget feeded back per request).
+// Bytes are logical expert payloads; all arithmetic is saturating u64.
+
+namespace {
+constexpr uint64_t kGovernorQuantumBytes = 128ULL << 20;  // 128 MiB
+constexpr uint64_t kGovernorFloorBytes = 64ULL << 20;     // 64 MiB
+constexpr const char* kGovernorEnv = "MOE_SPEC_ADMISSION_CODE";
+
+uint64_t governor_sub_saturate(uint64_t a, uint64_t b) {
+  return a > b ? a - b : 0ULL;
+}
+uint64_t governor_add_saturate(uint64_t a, uint64_t b) {
+  return a > UINT64_MAX - b ? UINT64_MAX : a + b;
+}
+}  // namespace
+
+void ExpertDispatcher::ConfigureSpeculativeGovernor(
+    int mode, const std::string& library, const std::string& bytecode,
+    bool verify, uint64_t initial_fixed_budget_bytes) {
+  TORCH_CHECK(governor_mode_ == 0, "speculative governor already configured");
+  TORCH_CHECK(mode == 1 || mode == 2 || mode == 3,
+              "governor mode must be unbounded=1, fixed=2, or adaptive=3");
+  TORCH_CHECK(initial_fixed_budget_bytes > 0,
+              "fixed governor budget must be positive");
+  if (mode == 3) {
+    // "native-rule" selects the built-in C++ admission rule below; anything
+    // else must be an absolute real-JIT bridge. A BPF failure is fatal; the
+    // native arm never silently degrades into the BPF path.
+    if (library == "native-rule") {
+      TORCH_CHECK(!verify,
+                  "native admission governor takes no BPF program");
+    } else {
+      TORCH_CHECK(!library.empty() && library[0] == '/' && !bytecode.empty() &&
+                      bytecode[0] == '/' && verify,
+                  "adaptive governor requires absolute real-JIT artifacts");
+      governor_library_ = dlopen(library.c_str(), RTLD_NOW | RTLD_LOCAL);
+      TORCH_CHECK(governor_library_, "cannot load speculative governor library");
+      auto init = reinterpret_cast<int (*)(const char*)>(
+          dlsym(governor_library_, "moe_spec_admission_init_v1"));
+      governor_admit_ = reinterpret_cast<int (*)(const moe_spec_candidate*, mep_u32,
+                                                 mep_u64, mep_u64, mep_u64, mep_u64*)>(
+          dlsym(governor_library_, "moe_spec_admission_prefix_v1"));
+      TORCH_CHECK(init && governor_admit_ && init(bytecode.c_str()) == 0,
+                  "speculative governor BPF init failed; no fallback");
+    }
+  }
+  governor_fixed_budget_bytes_ = initial_fixed_budget_bytes;
+  governor_budget_bytes_ = initial_fixed_budget_bytes;
+  governor_initial_budget_bytes_ = initial_fixed_budget_bytes;
+  governor_mode_ = mode;
+}
+
+void ExpertDispatcher::RecordRequestSpeculativeOutcome(
+    const std::map<std::string, uint64_t>& outcome) {
+  if (!governor_mode_ || governor_mode_ != 3) return;
+  auto read = [&outcome](const char* key) {
+    auto it = outcome.find(key);
+    TORCH_CHECK(it != outcome.end() && it->second >= 0,
+                "governor outcome missing key ", key);
+    return static_cast<uint64_t>(it->second);
+  };
+  const uint64_t hit = read("prefetch_hit_bytes");
+  const uint64_t evicted_unused = read("prefetch_wasted_bytes");
+  const uint64_t censor = read("prefetch_unused_resident_bytes");
+  const uint64_t wait_ns = read("demand_prefetch_wait_ns") +
+                           read("demand_cache_wait_ns");
+  const uint64_t resolved = governor_add_saturate(hit, evicted_unused);
+  const uint64_t observed = governor_add_saturate(resolved, censor);
+  // Signed useful-minus-unused fraction, damped by the censored fraction.
+  // Only the sign of (useful - unused) moves the budget; the useful/unused
+  // magnitudes never scale the quantum, keeping the rule exact and cheap.
+  const uint64_t useful = hit;
+  const uint64_t unused = evicted_unused;
+  {
+    std::lock_guard<std::mutex> lock(governor_mutex_);
+    uint64_t budget = governor_budget_bytes_;
+    uint64_t before = budget;
+    if (observed == 0) {
+      // No resolved or censored outcome in this request: hold the budget.
+      ++governor_budget_unchanged_;
+    } else if (wait_ns > 0) {
+      // Live mandatory demand waited on this executor: reduce at least one
+      // quantum. One quantum per observed demand-wait event, not per ns.
+      budget = governor_sub_saturate(budget, kGovernorQuantumBytes);
+      if (budget < kGovernorFloorBytes) budget = kGovernorFloorBytes;
+    } else if (useful > unused) {
+      budget = governor_add_saturate(budget, kGovernorQuantumBytes);
+      const uint64_t max_budget = governor_initial_budget_bytes_ * 4;
+      if (budget > max_budget) budget = max_budget;
+    } else if (unused > useful) {
+      budget = governor_sub_saturate(budget, kGovernorQuantumBytes);
+      if (budget < kGovernorFloorBytes) budget = kGovernorFloorBytes;
+    } else {
+      ++governor_budget_unchanged_;
+    }
+    governor_budget_bytes_ = budget;
+    governor_history_budget_.push_back(budget);
+    governor_history_new_hit_bytes_.push_back(hit);
+    governor_history_new_evicted_unused_bytes_.push_back(evicted_unused);
+    governor_history_censored_bytes_.push_back(censor);
+    governor_history_demand_wait_ns_.push_back(wait_ns);
+    ++governor_budget_updates_;
+    if (budget > before) ++governor_budget_increases_;
+    else if (budget < before) ++governor_budget_decreases_;
+  }
+}
+
+// Live whole-expert prefix admission: returns how many ranked candidates fit
+// under the current budget minus outstanding speculative bytes. Called by
+// SubmitActivationPrefetch with the publisher's activation mutex held; the
+// queue read below is the shared-executor outstanding-byte source of truth.
+size_t ExpertDispatcher::AdmitSpeculativePrefix(
+    const std::vector<uint64_t>& payload_bytes) {
+  TORCH_CHECK(governor_mode_ != 0,
+              "speculative governor used without configuration");
+  if (governor_mode_ == 1) return payload_bytes.size();
+  std::lock_guard<std::mutex> lock(governor_mutex_);
+  ++governor_admission_calls_;
+  const uint64_t budget = governor_budget_bytes_;
+  uint64_t outstanding = 0;
+  for (const auto& queue : input_queue_) {
+    outstanding = governor_add_saturate(
+        outstanding, queue.BackgroundOutstandingSnapshot());
+  }
+  const uint64_t allowed = governor_sub_saturate(budget, outstanding);
+  governor_last_allowed_bytes_ = allowed;
+  governor_last_outstanding_bytes_ = outstanding;
+  governor_last_used_bytes_ = 0;
+  governor_last_candidate_count_ = payload_bytes.size();
+  if (governor_mode_ == 3 && governor_admit_) {
+    // Real-JIT route: marshal the exact snapshot the BPF rule sees. Payload
+    // sizes ride in the entry array; a failure is fatal, never a native
+    // fallback. The C++ rule below runs only for the native governor mode.
+    std::vector<moe_spec_candidate> candidates(payload_bytes.size());
+    for (size_t index = 0; index < payload_bytes.size(); ++index)
+      candidates[index] = {payload_bytes[index], 0};
+    mep_u64 admitted = MOE_SPEC_NONE;
+    const int rc = governor_admit_(candidates.data(),
+                                   static_cast<mep_u32>(candidates.size()),
+                                   budget, outstanding, 0, &admitted);
+    TORCH_CHECK(rc == 0, "speculative governor BPF admission failed; no fallback");
+    TORCH_CHECK(admitted == MOE_SPEC_NONE || admitted <= candidates.size(),
+                "speculative governor BPF returned invalid prefix");
+    const size_t admitted_count =
+        admitted == MOE_SPEC_NONE ? 0 : static_cast<size_t>(admitted);
+    for (size_t index = 0; index < admitted_count; ++index)
+      governor_last_used_bytes_ = governor_add_saturate(
+          governor_last_used_bytes_, payload_bytes[index]);
+    return admitted_count;
+  }
+  uint64_t used = 0;
+  size_t admitted = 0;
+  while (admitted < payload_bytes.size()) {
+    const uint64_t bytes = payload_bytes[admitted];
+    if (bytes == 0 || used + bytes > allowed) break;
+    used = governor_add_saturate(used, bytes);
+    ++admitted;
+  }
+  governor_last_used_bytes_ = used;
+  return admitted;
+}
+
+std::map<std::string, uint64_t> ExpertDispatcher::GetGovernorStats() const {
+  std::lock_guard<std::mutex> lock(governor_mutex_);
+  return {{"governor_mode", static_cast<uint64_t>(governor_mode_)},
+          {"governor_initial_budget_bytes", governor_initial_budget_bytes_},
+          {"governor_budget_bytes", governor_budget_bytes_},
+          {"governor_admission_calls", governor_admission_calls_},
+          {"governor_admission_submitted", governor_admission_submitted_.load()},
+          {"governor_admission_admitted", governor_admission_admitted_.load()},
+          {"governor_budget_updates", governor_budget_updates_},
+          {"governor_budget_unchanged", governor_budget_unchanged_},
+          {"governor_budget_decreases", governor_budget_decreases_},
+          {"governor_budget_increases", governor_budget_increases_},
+          {"governor_last_allowed_bytes", governor_last_allowed_bytes_},
+          {"governor_last_outstanding_bytes", governor_last_outstanding_bytes_},
+          {"governor_last_used_bytes", governor_last_used_bytes_},
+          {"governor_last_candidate_count", governor_last_candidate_count_}};
+}
