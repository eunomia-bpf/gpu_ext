+/* Net-releasable KV bytes for candidate c: the bytes the reclaim actually
+ * frees for other work. With known coverage the request's own disk-backed
+ * prefix is expected to re-occupy its backed transfer bytes at resume
+ * (observed resumes re-read the full backed prefix), so that share is
+ * netted out: freeable_bytes - min(freeable_bytes, disk_backed_bytes).
+ * Unknown coverage is not netted and keeps the raw footprint. Compare-
+ * and-subtract only (no division), saturating at 0; the caller treats 0
+ * as "the reclaim pays a restore and funds no free pages" and keeps the
+ * stock victim. */
+UVM_KV_RECLAIM_FN NvU64 uvm_kv_reclaim_net_freeable(
+    const uvm_bpf_kv_reclaim_candidate_t *c)
+{
+    NvU64 rebind = (c->flags & UVM_KV_RECLAIM_CANDIDATE_FLAG_COVERAGE_KNOWN) ?
+        c->disk_backed_bytes : 0;
+
+    if (rebind >= c->freeable_bytes)
+        return 0;
+    return c->freeable_bytes - rebind;
+}
