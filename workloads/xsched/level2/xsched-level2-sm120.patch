@@ -20,3 +20,15 @@ xsched::cuda::CudaLv3Implementation xsched::cuda::GetCudaLv3Implementation()
     }();
     return impl;
 }
+
+bool xsched::cuda::GetCudaLv2Arch120Port()
+{
+    static const bool port = GetEnvOption("XSCHED_CUDA_LV2_PORT_120", false);
+    return port;
+}
+
+bool xsched::cuda::GetLevel2ToolActuator()
+{
+    static const bool act = GetEnvOption("XSCHED_LEVEL2_TOOL_ACTUATOR", false);
+    return act;
+}
