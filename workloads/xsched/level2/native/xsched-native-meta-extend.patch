+// Grown-kernel detection for launch corridors that bypass the command
+// ownership (plain passthrough with the app's raw parameter pointers).
+// With the shim's opt-in KPARAM growth (XG_NATIVE_META_KPARAM), an
+// ordinary kernelParams launch makes the DRIVER copy per-ordinal at the
+// loaded (grown) sizes, which would read past the app's original-sized
+// argument storage (e.g. the 8-byte timer argument vs the 0x1520 grown
+// extent). For kernels whose ordinal table was grown, the passthrough
+// corridors therefore construct an owned deep copy instead - the
+// CudaKernelCommand constructor zero-fills the grown extent and copies
+// only the original per-ordinal bytes (cuda_command.cpp). Non-grown
+// kernels keep the zero-cost passthrough. Relay/instrumented launches
+// are unaffected (they adopt the relay blob under the launch mutex).
+static bool XgKernelGrown(CUfunction f)
+{
+    // cheap gate first: nothing registered -> nothing can be grown
+    if (XgHasRelayLayouts() != 1) return false;
+    // enumerate the loaded param layout (count/offsets/sizes)
+    unsigned int offsets[32];
+    unsigned int sizes[32];
+    unsigned int cnt = 0;
+    for (unsigned int i = 0; i < 32; ++i) {
+        size_t off = 0, sz = 0;
+        if (Driver::FuncGetParamInfo(f, i, &off, &sz) != CUDA_SUCCESS) break;
+        offsets[i] = (unsigned int)off;
+        sizes[i] = (unsigned int)sz;
+        ++cnt;
+    }
+    if (cnt == 0) return false;
+    // name-free identification: match the loaded shape against the
+    // registered original layouts (does not depend on cuFuncGetName)
+    size_t ocnt = 0;
+    return XgFindRelayOriginalParams(cnt, offsets, sizes, nullptr, nullptr,
+                                     nullptr, 0, &ocnt) == 1 && ocnt != 0;
+}
