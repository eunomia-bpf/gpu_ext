+// Shared executor constraint, not an additional ranking policy. The owner must
+// hold its activation mutex for every call and through the corresponding victim
+// removal / physical-copy issue. Demand does not consult this protection set.
+class RevisionPredictionSet {
+ public:
+  uint64_t Invalidate() {
+    if (epoch_ == std::numeric_limits<uint64_t>::max())
+      throw std::overflow_error("paper prediction epoch exhausted");
+    ++epoch_;
+    candidates_.clear();
+    return epoch_;
+  }
+  uint64_t Replace(const std::vector<uint64_t>& candidates) {
+    // Build before publishing so allocation failure cannot expose a partial set.
+    std::unordered_set<uint64_t> replacement(candidates.begin(), candidates.end());
+    Invalidate();
+    candidates_.swap(replacement);
+    return epoch_;
+  }
+  bool Current(uint64_t epoch) const { return epoch != 0 && epoch == epoch_; }
+  bool MayEvict(uint64_t epoch, uint64_t resident) const {
+    return Current(epoch) && candidates_.find(resident) == candidates_.end();
+  }
+  uint64_t Epoch() const { return epoch_; }
+  uint64_t Size() const { return candidates_.size(); }
+ private:
+  uint64_t epoch_ = 0;
+  std::unordered_set<uint64_t> candidates_;
+};
+
+// One worker owns cache accounting. Demand always wins over queued prefetch;
+// replacing predictions discards only unstarted background work, never demand.
+template <typename T>
+class RevisionFetchQueue {
+ public:
+  void Push(T& item) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!closed_) demand_.push_back(std::move(item));
+    ready_.notify_one();
+  }
+  // Replaces the pending background stream atomically; the publisher holds
+  // the activation mutex and reports the exact queued whole-entry bytes.
+  void ReplaceBackground(std::vector<T> items, const std::vector<uint64_t>& item_bytes,
+                         uint64_t queued_bytes) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    background_.clear();
+    background_bytes_.clear();
+    background_pop_bytes_.clear();
+    if (!closed_) {
+      for (auto& item : items) background_.push_back(std::move(item));
+      background_bytes_.assign(item_bytes.begin(), item_bytes.end());
+    }
+    background_queued_bytes_ = queued_bytes;
+    ready_.notify_one();
+  }
+  // Exact live outstanding speculative bytes: what the publisher queued plus
+  // what the fetch worker still carries. Set from the completion path.
+  uint64_t BackgroundOutstandingSnapshot() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return background_queued_bytes_ + inflight_bytes_;
+  }
+  void CompleteBackgroundBytes(uint64_t bytes) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (inflight_bytes_ >= bytes)
+      inflight_bytes_ -= bytes;
+    else
+      inflight_bytes_ = 0;
+  }
+  void TrackInflightBytes(uint64_t bytes) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    inflight_bytes_ += bytes;
+  }
+  bool Pop(T& item) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    ready_.wait(lock, [&] {
+      return closed_ || !demand_.empty() || !background_.empty();
+    });
+    if (closed_) return false;
+    bool background = demand_.empty();
+    auto& queue = background ? background_ : demand_;
+    item = std::move(queue.front());
+    queue.pop_front();
+    if (background) {
+      ++background_inflight_;
+      // Move the popped entry's bytes from queued to inflight so the live
+      // outstanding sum stays exact: debit queued, the worker immediately
+      // re-credits the same amount through TrackInflightBytes.
+      if (!background_bytes_.empty()) {
+        const uint64_t bytes = background_bytes_.front();
+        background_bytes_.pop_front();
+        background_queued_bytes_ -=
+            background_queued_bytes_ < bytes ? background_queued_bytes_ : bytes;
+        background_pop_bytes_.push_back(bytes);
+      }
+    }
+    return true;
+  }
+
+  void CompleteBackground() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    --background_inflight_;
+    // Release the popped entry's bytes from the inflight ledger; the fetch
+    // worker additionally calls TrackInflightBytes at issue and
+    // CompleteBackgroundBytes after the CUDA copy, both of which must pair
+    // with the ledger handoff below to keep the snapshot exact.
+    if (!background_pop_bytes_.empty()) {
+      const uint64_t bytes = background_pop_bytes_.front();
+      background_pop_bytes_.pop_front();
+      if (inflight_bytes_ >= bytes) inflight_bytes_ -= bytes;
+      else inflight_bytes_ = 0;
+    }
+    ready_.notify_all();
+  }
+  void DrainBackground() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    // Discarding queued work also discards its queued bytes; popped entries
+    // release through the pop-ledger side in CompleteBackground.
+    for (const uint64_t bytes : background_bytes_)
+      background_queued_bytes_ -=
+          background_queued_bytes_ < bytes ? background_queued_bytes_ : bytes;
+    background_bytes_.clear();
+    background_.clear();
+    ready_.wait(lock, [&] { return background_inflight_ == 0; });
+  }
+  void Close() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    closed_ = true;
+    for (const uint64_t bytes : background_bytes_)
+      background_queued_bytes_ -=
+          background_queued_bytes_ < bytes ? background_queued_bytes_ : bytes;
+    background_bytes_.clear();
+    background_pop_bytes_.clear();
+    background_.clear();
+    ready_.notify_all();
+  }
+  void NotifyAll() { ready_.notify_all(); }
+private:
+  mutable std::mutex mutex_;
+  std::condition_variable ready_;
+  std::deque<T> demand_, background_;
+  // Parallel byte ledger: queued totals per not-yet-popped background entry,
+  // then bytes of entries popped but not yet completed. Keeps the outstanding
+  // snapshot exact without requiring T to know its payload size.
+  std::deque<uint64_t> background_bytes_;
+  std::deque<uint64_t> background_pop_bytes_;
+  bool closed_ = false;
+  unsigned background_inflight_ = 0;
+  uint64_t background_queued_bytes_ = 0;
+  uint64_t inflight_bytes_ = 0;
+};
