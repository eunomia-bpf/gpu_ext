+    resize_buffers(chunk_rows);
+
+    auto input_chunk = hidden_contiguous.narrow(0, row_begin, chunk_rows);
+    cudaMemcpyAsync(input_.data_ptr(), input_chunk.data_ptr(),
+                    input_chunk.numel() * input_chunk.element_size(),
+                    cudaMemcpyDeviceToDevice, stream);
+    cudaStreamSynchronize(stream);
+
+    ForwardHelper(stream);
+    output.narrow(0, row_begin, chunk_rows).copy_(output_);
   }
