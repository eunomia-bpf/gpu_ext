+void ExpertDispatcher::ConfigureActivationPolicy(
+    int mode, const std::string& library, const std::string& bytecode, bool verify,
+    bool prefetch_enabled) {
+  TORCH_CHECK(mode == 1 || mode == 2, "paper policy mode must be native=1 or BPF=2");
+  TORCH_CHECK(activation_mode_.load() == 0, "paper policy already configured");
+  if (mode == 2) {
+    TORCH_CHECK(!library.empty() && library[0] == '/' && !bytecode.empty() &&
+                bytecode[0] == '/', "absolute BPF artifact paths required");
+    activation_library_ = dlopen(library.c_str(), RTLD_NOW | RTLD_LOCAL);
+    TORCH_CHECK(activation_library_, "cannot load paper BPF library");
+    auto init = reinterpret_cast<int (*)(const char*)>(
+        dlsym(activation_library_, "moe_expert_scored_init_v1"));
+    activation_select_ = reinterpret_cast<decltype(activation_select_)>(
+        dlsym(activation_library_, "moe_expert_scored_select_v1"));
+    TORCH_CHECK(init && activation_select_ && init(bytecode.c_str()) == 0,
+                "paper BPF init failed; no fallback");
+  }
+  activation_scores_.assign(num_experts_ * experts_[0].size(), 1.0);
+  activation_verify_ = verify;
+  activation_prefetch_enabled_ = prefetch_enabled;
+  activation_mode_.store(mode, std::memory_order_release);
+}
+
+void ExpertDispatcher::SetActivationScores(const std::vector<double>& scores) {
+  TORCH_CHECK(activation_mode_.load(), "paper policy not configured");
+  TORCH_CHECK(scores.size() == num_experts_ * experts_[0].size(),
+              "paper score dimensions mismatch");
+  {
+    std::lock_guard<std::mutex> lock(activation_mutex_);
+    activation_prediction_.Invalidate();
+    activation_scores_ = scores;
+    for (auto& queue : input_queue_) queue.ReplaceBackground({}, {}, 0);
+  }
+}
+
+void ExpertDispatcher::SubmitActivationPrefetch(const std::vector<uint64_t>& identities) {
+  TORCH_CHECK(activation_mode_.load(), "paper policy not configured");
+  if (!activation_prefetch_enabled_) {
+    std::lock_guard<std::mutex> lock(activation_mutex_);
+    activation_prediction_.Invalidate();
+    for (auto& queue : input_queue_) queue.ReplaceBackground({}, {}, 0);
+    return;
+  }
+  // Governor admission (experiment axis): modes 2/3 keep only the largest
+  // ranked whole-expert prefix fitting the live byte headroom rule; mode 1
+  // publishes the full rank, meaning identical behavior to pre-governor arms.
+  std::vector<uint64_t> admitted_identities;
+  if (governor_mode_ == 2 || governor_mode_ == 3) {
+    TORCH_CHECK(governor_fixed_budget_bytes_ > 0,
+                "governor configured without a positive byte budget");
+    // Whole-expert payload bytes: the same node byte_size the executor uses
+    // for demand/speculative logical-byte accounting.
+    std::vector<uint64_t> payload_bytes;
+    payload_bytes.reserve(identities.size());
+    for (auto key : identities) {
+      const auto layer = key >> 32;
+      const auto expert = key & 0xffffffffULL;
+      payload_bytes.push_back(experts_[expert][layer]->node->byte_size);
+    }
+    const size_t admitted_count = AdmitSpeculativePrefix(payload_bytes);
+    governor_admission_submitted_.fetch_add(identities.size(),
+                                            std::memory_order_relaxed);
+    governor_admission_admitted_.fetch_add(admitted_count,
+                                           std::memory_order_relaxed);
+    admitted_identities.assign(identities.begin(),
+                               identities.begin() + admitted_count);
+  } else {
+    admitted_identities = identities;
+  }
+  std::vector<std::vector<CallArgs>> work(kNumDevices());
+  for (auto key : admitted_identities) {
+    auto layer = key >> 32;
+    auto expert = key & 0xffffffffULL;
+    TORCH_CHECK(expert < experts_.size() && layer < experts_[expert].size(),
+                "paper prefetch returned invalid expert identity");
+    CallArgs item;
+    item.layer_idx = layer;
+    item.expert_idx = expert;
+    item.gpu_id = expert % kNumDevices();
+    item.activation_prefetch = true;
+    work[item.gpu_id].push_back(item);
+  }
+  std::lock_guard<std::mutex> lock(activation_mutex_);
+  const auto epoch = activation_prediction_.Replace(admitted_identities);
+  activation_submitted_.fetch_add(admitted_identities.size());
+  for (int gpu = 0; gpu < kNumDevices(); ++gpu) {
+    std::vector<uint64_t> item_bytes;
+    item_bytes.reserve(work[gpu].size());
+    uint64_t queued_bytes = 0;
+    for (auto& item : work[gpu]) {
+      item.prediction_epoch = epoch;
+      const uint64_t bytes = experts_[item.expert_idx][item.layer_idx]->node->byte_size;
+      item_bytes.push_back(bytes);
+      queued_bytes += bytes;
+    }
+    input_queue_[gpu].ReplaceBackground(std::move(work[gpu]), item_bytes,
+                                        queued_bytes);
+  }
+}
+
+void ExpertDispatcher::RecordActivationUse(uint64_t key) {
+  if (!activation_mode_.load()) return;
+  std::lock_guard<std::mutex> lock(activation_mutex_);
+  if (unused_activation_prefetch_.erase(key)) {
+    activation_hits_.fetch_add(1);
+    auto layer = key >> 32;
+    auto expert = key & 0xffffffffULL;
+    activation_hit_bytes_.fetch_add(experts_[expert][layer]->node->byte_size);
+  }
+}
+
+void ExpertDispatcher::RecordDemandAccess(bool prefill, bool hit) {
+  if (!activation_mode_.load(std::memory_order_acquire)) return;
+  auto& accesses = prefill ? demand_prefill_accesses_ : demand_decode_accesses_;
+  auto& hits = prefill ? demand_prefill_hits_ : demand_decode_hits_;
+  accesses.fetch_add(1, std::memory_order_relaxed);
+  if (hit) hits.fetch_add(1, std::memory_order_relaxed);
+}
+
+void ExpertDispatcher::DrainActivationPrefetch() {
+  if (!activation_mode_.load(std::memory_order_acquire)) return;
+  {
+    std::lock_guard<std::mutex> lock(activation_mutex_);
+    activation_prediction_.Invalidate();
+    for (auto& queue : input_queue_) queue.ReplaceBackground({}, {}, 0);
+  }
+  // Never wait while holding activation_mutex_: a copy already issued is
+  // allowed to finish, account its residency and release its claimed node.
+  for (auto& queue : input_queue_) queue.DrainBackground();
+  for (auto& queue : input_queue_) {
+    while (queue.BackgroundOutstandingSnapshot() != 0) {
+      std::this_thread::yield();
+    }
+  }
+}
