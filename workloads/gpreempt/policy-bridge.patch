diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -134,1 +134,12 @@
+set(GPREEMPT_ARTIFACT_DIR "" CACHE PATH "Local comparison instrumentation")
+set(GPREEMPT_BRIDGE_DIR "" CACHE PATH "gpubpf extension bridge directory")
+if(NOT EXISTS "${GPREEMPT_ARTIFACT_DIR}/client_checks.h" OR
+   NOT EXISTS "${GPREEMPT_BRIDGE_DIR}/.output/libgpreempt_bridge.so")
+    message(FATAL_ERROR "Build the gpreempt extension bridge and set both comparison paths")
+endif()
+include_directories("${GPREEMPT_ARTIFACT_DIR}" "${GPREEMPT_BRIDGE_DIR}")
+add_library(gpreempt_policy_bridge SHARED IMPORTED)
+set_target_properties(gpreempt_policy_bridge PROPERTIES IMPORTED_LOCATION
+    "${GPREEMPT_BRIDGE_DIR}/.output/libgpreempt_bridge.so")
+
 foreach(CLIENT_SOURCE ${CLIENT_SOURCES})
@@ -148,1 +159,6 @@
 endforeach()
+foreach(GPREEMPT_CLIENT baseclient gpreemptclient gpreemptclient_wo)
+    if(TARGET ${GPREEMPT_CLIENT})
+        target_link_libraries(${GPREEMPT_CLIENT} gpreempt_policy_bridge)
+    endif()
+endforeach()
