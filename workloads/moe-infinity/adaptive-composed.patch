+std::vector<double> MoEMLP::NumericalRowChunkingCheck(int64_t rows,
+                                                       double rtol,
+                                                       double atol) {
+  TORCH_CHECK(rows == 1 || rows == 256 || rows == 257 || rows == 353,
+              "unsupported row-chunking self-test size");
+  TORCH_CHECK(rtol >= 0.0 && atol >= 0.0,
+              "row-chunking self-test tolerances must be non-negative");
+
+  constexpr int64_t hdim = 64;
+  constexpr int64_t idim = 96;
+  auto float_options = torch::TensorOptions()
+                           .dtype(torch::kFloat32)
+                           .device(CUDA_DEVICE(at::cuda::current_device()));
+  auto bf16_options = float_options.dtype(torch::kBFloat16);
+  auto stream = at::cuda::getCurrentCUDAStream().stream();
+
+  auto hidden = (torch::sin(torch::arange(rows * hdim, float_options) * 0.013)
+                     .reshape({rows, hdim}) *
+                 0.125)
+                    .to(torch::kBFloat16);
+  auto first_weight =
+      (torch::cos(torch::arange(idim * hdim, float_options) * 0.017)
+           .reshape({idim, hdim}) *
+       0.0625)
+          .to(torch::kBFloat16);
+  auto second_weight =
+      (torch::sin(torch::arange(hdim * idim, float_options) * 0.019)
+           .reshape({hdim, idim}) *
+       0.0625)
+          .to(torch::kBFloat16);
+
+  MoEMLP module(DTYPE_BFLOAT16, NLLB_MOE_DENSE_ACT_DENSE);
+  module.buffer_[0] = torch::empty({kMaxTokens, hdim}, bf16_options);
+  module.buffer_[1] = torch::empty({kMaxTokens, hdim}, bf16_options);
+  module.param_[0] = first_weight;
+  module.param_[1] = second_weight;
+  module.param_init_ = true;
+  module.param_set_ = true;
+
+  auto actual = module.forward(hidden, stream);
+  cudaStreamSynchronize(stream);
+
+  auto reference = torch::empty_like(hidden);
+  for (int64_t row_begin = 0; row_begin < rows;
+       row_begin += kMaxTokens) {
+    int64_t chunk_rows = std::min(kMaxTokens, rows - row_begin);
+    auto input_chunk = hidden.narrow(0, row_begin, chunk_rows);
+    auto reference_chunk = torch::matmul(
+        torch::relu(torch::matmul(input_chunk, first_weight.transpose(0, 1))),
+        second_weight.transpose(0, 1));
+    reference.narrow(0, row_begin, chunk_rows).copy_(reference_chunk);
+  }
+  cudaStreamSynchronize(stream);
+
+  auto absolute = (actual.to(torch::kFloat32) - reference.to(torch::kFloat32))
+                      .abs();
+  double max_abs = absolute.max().item<double>();
+  auto denominator = reference.to(torch::kFloat32).abs().clamp_min(1.0e-6);
+  double max_rel = (absolute / denominator).max().item<double>();
+  bool close = torch::allclose(actual, reference, rtol, atol);
+  return {max_abs, max_rel, close ? 1.0 : 0.0};
+}
